{
  "name": "projection_library",
  "version": "2.0.0",
  "description": "Projection Lab: a from-scratch WebGL game engine in plain ES modules (cascaded shadows, PBR materials, skinned glTF characters, instancing, particles, post effects), built on a hand-made orbit camera and dot-product projection",
  "keywords": ["webgl", "webgl2", "game-engine", "3d", "graphics", "gltf", "pbr", "shadows", "javascript", "es-modules"],
  "homepage": "https://rohitpatil9121.github.io/projection_library/",
  "repository": { "type": "git", "url": "git+https://github.com/rohitpatil9121/projection_library.git" },
  "author": "Rohit Patil",
  "contributors": ["Rohit Sawant (https://github.com/rohit-s-init)"],
  "license": "ISC",
  "main": "index.js",
  "exports": {
    ".": "./public/engine/index.js",
    "./engine/*": "./public/engine/*",
    "./shaders/*": "./public/shaders/*"
  },
  "files": ["public/engine", "public/shaders", "public/vendor/gl-matrix@3.4.4", "public/vendor/zzfx@1.3.2", "README.md", "THIRD_PARTY.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node tools/serve.mjs",
    "start:express": "node index.js",
    "test": "node tools/test.mjs",
    "build": "node tools/build.mjs",
    "docs": "node tools/build-docs.mjs",
    "shots": "node tools/shots.mjs"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
